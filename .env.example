# Copy to .env (which is git-ignored). Nothing here is needed for the offline demo.

# NASA Earthdata Login - only needed to download or remotely crop NISAR products.
# Create a free account at https://urs.earthdata.nasa.gov/ . Either a token...
EARTHDATA_TOKEN=
# ...or a username and password.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Where the fixtures live (default: ./data/fixtures).
TRIAGESAR_DATA_DIR=

# Optional: alternative Overpass API endpoint for scripts/fetch_osm_roads.py.
TRIAGESAR_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Development only: also serve the TEST ONLY synthetic event (never set this on a public demo).
# TRIAGESAR_INCLUDE_SYNTHETIC=1
